    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "ws": "^8.18.0"
  }
}
